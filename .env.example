# The scanner's and the digest's connection to Supabase. Locally: the API URL and the secret key from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Email for the scanner health check, the daily digest and the admin emails. Locally: Mailpit at 127.0.0.1, port 54325, no user or password.
# Live: Brevo (smtp-relay.brevo.com, 587, the Brevo SMTP login and an SMTP key).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=54325
EMAIL_USER=
EMAIL_PASS=
# The sender address. Live: no-reply@wirescout.app. Empty: a made-up …@wirescout.local address.
EMAIL_FROM=
# Who gets the health check email, new access requests and the monthly usage report (the Wirescout team).
# Without it, the scanner and the admin emails send nothing.
ADMIN_EMAIL=dev@example.com
# The web app, for the links in the digest email. Locally: the dev server.
APP_URL=http://127.0.0.1:3000
# Post to MODX: Edge Function secrets, not used by the scanner. Locally they go in supabase/functions/.env;
# in the cloud Ken sets them (Edge Functions → Secrets).
# 32 random bytes, base64 (openssl rand -base64 32): locks the stored MODX sessions.
MAGAZINE_SESSION_KEY=
# The draft-text function's key for Claude Haiku 5.5. Without it, the Send dialog uses the story's own text.
ANTHROPIC_API_KEY=
