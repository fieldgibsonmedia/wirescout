{
  "name": "wirescout",
  "version": "1.0.0",
  "description": "Lightweight scraper bot that monitors websites for new articles",
  "main": "src/scanner/index.js",
  "type": "module",
  "scripts": {
    "scan": "node src/scanner/index.js",
    "digest": "node src/digest/index.js",
    "test": "node --test \"src/scanner/**/*.test.js\" \"src/digest/**/*.test.js\"",
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "types": "supabase gen types typescript --local > src/app/lib/database.types.ts"
  },
  "author": "Kenneth Zuniga and Martin Assman, Field Gibson Media",
  "license": "MIT",
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/vue-table": "^9.3.1",
    "cheerio": "^1.0.0-rc.12",
    "chrono-node": "^2.9.0",
    "dotenv": "^16.0.3",
    "nodemailer": "^6.9.9",
    "read-excel-file": "^9.3.12",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
